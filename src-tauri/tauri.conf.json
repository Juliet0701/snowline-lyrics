{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snowline Lyrics Rust Preview",
  "version": "0.5.0-alpha.2",
  "identifier": "io.github.juliet0701.snowline-lyrics.preview",
  "build": { "frontendDist": "../rust-ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "board", "title": "Snowline Lyrics · Rust Preview", "url": "index.html", "width": 680, "height": 240, "minWidth": 400, "minHeight": 180, "decorations": false, "transparent": true, "alwaysOnTop": true },
      { "label": "settings", "title": "Snowline Lyrics · Rust 迁移检查", "url": "index.html?settings", "width": 900, "height": 680, "visible": false }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
