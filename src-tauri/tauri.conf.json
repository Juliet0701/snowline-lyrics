{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snowline Lyrics",
  "version": "0.5.1",
  "identifier": "io.github.juliet0701.snowline-lyrics",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "board",
        "title": "Snowline Lyrics",
        "url": "board.html",
        "width": 600,
        "height": 310,
        "minWidth": 400,
        "minHeight": 180,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}