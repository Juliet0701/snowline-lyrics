{
  "name": "snowline-lyrics",
  "productName": "Snowline Lyrics",
  "version": "0.1.0",
  "description": "A floating Windows lyric board powered by system media sessions and timestamped lyrics.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {"node": ">=22"},
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build:native": "pwsh -NoProfile -File scripts/build-media.ps1",
    "package:windows": "node scripts/package-windows.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "test:desktop": "node scripts/desktop-check.mjs"
  },
  "devDependencies": {"electron": "43.3.0", "playwright-core": "1.56.1"}
}
