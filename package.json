{
  "name": "snowline-lyrics",
  "productName": "Snowline Lyrics",
  "version": "0.5.2",
  "description": "A native Rust and Tauri Windows lyric board with synchronized lyrics.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "cargo run --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path rust/core/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "node scripts/check.mjs",
    "build": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "package:windows": "node scripts/package-rust.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "test:desktop": "node scripts/rust-desktop-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
